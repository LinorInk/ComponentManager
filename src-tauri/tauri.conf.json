{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ComponentManager",
  "version": "0.1.1",
  "identifier": "com.componentmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build && node scripts/sync-cli.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "元件库存管理器",
        "width": 1000,
        "height": 680,
        "minWidth": 780,
        "minHeight": 480,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "externalBin": ["bin/cmcli"],
    "category": "Utility",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
